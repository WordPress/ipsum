{
	"name": "ipsum",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"wp-env": "wp-env",
		"env:setup": "wp-env start && wp-env run cli wp theme activate ipsum && wp-env run cli wp plugin install gutenberg theme-check --activate",
		"env:start": "wp-env start",
		"env:status": "wp-env status",
		"env:stop": "wp-env stop",
		"env:reset": "wp-env reset",
		"build": "postcss style.css --use cssnano -o style.min.css --no-map",
		"watch": "postcss style.css --use cssnano -o style.min.css --no-map --watch"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.55.0",
		"@wordpress/env": "^11.15.0",
		"cssnano": "^7.1.9",
		"postcss": "^8.5.28",
		"postcss-cli": "^11.0.1"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	]
}
